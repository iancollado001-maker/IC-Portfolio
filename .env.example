# Copy to .env.local for local development. Never commit real values.

# Required for the contact form to deliver email. Provisioned automatically when the
# Resend integration is added on Vercel (vercel integration add resend/resend-email).
RESEND_API_KEY=

# Optional. Inbox that receives contact messages. Defaults to personal.email in lib/site-config.ts.
CONTACT_TO_EMAIL=

# Optional. Sender address; must use a domain verified in Resend.
# Defaults to "Portfolio Contact <onboarding@resend.dev>", which Resend only delivers
# to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=
